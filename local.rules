alert icmp any any -> any any (msg:"NETGUARD - Possible ICMP Sweep"; detection_filter:track by_src,count 10,seconds 5; sid:1000001; rev:1;)

alert tcp any any -> any any (msg:"NETGUARD - Possible TCP SYN Port Scan"; flags:S; detection_filter:track by_src,count 20,seconds 5; sid:1000002; rev:1;)

alert tcp any any -> any 22 (msg:"NETGUARD - Possible SSH Brute-Force Connection Burst"; flags:S; detection_filter:track by_src,count 5,seconds 60; sid:1000003; rev:1;)

alert tcp any any -> any 8080 (msg:"NETGUARD - Possible C2 Beacon Pattern"; flow:to_server; content:"/beacon"; detection_filter:track by_src,count 5,seconds 60; sid:1000004; rev:1;)
